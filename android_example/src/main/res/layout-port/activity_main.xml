<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait layout with vertical arrangement. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    tools:context=".MainActivity">

    <!-- Top toolbar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        android:background="@color/toolbar_background"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Medivh Camera"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Status indicator. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/status_badge_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:id="@+id/status_indicator_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/tv_stream_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stopped"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Video preview area. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:background="@color/preview_background">

        <!-- Video preview. -->
        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- Preview placeholder. -->
        <LinearLayout
            android:id="@+id/preview_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_videocam"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/tv_preview_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/start_to_preview"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Live statistics overlay. -->
        <LinearLayout
            android:id="@+id/overlay_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:background="@drawable/stats_overlay_background"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_overlay_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="FPS: --" />

            <TextView
                android:id="@+id/tv_overlay_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"
                android:text="-- x --" />

            <TextView
                android:id="@+id/tv_overlay_frames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"
                android:text="Frames: 0" />
        </LinearLayout>

        <!-- Control button overlay. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_start_stream"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/control_button_primary"
                android:scaleType="center"
                android:contentDescription="@string/start_stream" />

            <ImageButton
                android:id="@+id/btn_stop_stream"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_stop"
                android:background="@drawable/control_button_secondary"
                android:scaleType="center"
                android:enabled="false"
                android:alpha="0.5"
                android:contentDescription="@string/stop_stream" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom control panel. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/panel_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Compact horizontal device and configuration selectors. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Device selector card. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_usb"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/device_selection"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageButton
                            android:id="@+id/btn_refresh"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_refresh"
                            android:background="@drawable/icon_button_background_small"
                            android:scaleType="center"
                            android:contentDescription="@string/refresh_devices" />
                    </LinearLayout>

                    <!-- Backend selector. -->
                    <RadioGroup
                        android:id="@+id/rg_backend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/rb_uvc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/backend_uvc"
                            android:checked="false"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <RadioButton
                            android:id="@+id/rb_camera2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/backend_camera2"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <RadioButton
                            android:id="@+id/rb_v4l2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/backend_v4l2"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tv_device_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/no_devices"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <Spinner
                        android:id="@+id/spinner_device"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>

                <!-- Configuration selector card. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/stream_config"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/select_config"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <Spinner
                        android:id="@+id/spinner_config"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="8dp" />

                    <Switch
                        android:id="@+id/switch_preview_render"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/disable_preview_render"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:checked="true"
                        android:showText="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compact horizontal statistics and controls. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:baselineAligned="false">

                <!-- Statistics card. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chart"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/statistics"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:text="---"
                        android:maxLines="3" />
                </LinearLayout>

                <!-- Camera controls card. -->
                <LinearLayout
                    android:id="@+id/layout_controls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="12dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="@string/camera_controls"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btn_reset_all"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_restore"
                            android:background="@drawable/icon_button_background_small"
                            android:scaleType="center"
                            android:contentDescription="@string/reset_all" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_control"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tv_control_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="9sp"
                            android:textColor="@color/text_hint"
                            android:text="Range: 0 - 255" />

                        <TextView
                            android:id="@+id/tv_control_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textSize="11sp"
                            android:textColor="@color/accent"
                            android:textStyle="bold"
                            android:text="128" />

                        <ImageButton
                            android:id="@+id/btn_reset_control"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_restore"
                            android:background="@drawable/icon_button_background_small"
                            android:scaleType="center"
                            android:contentDescription="Reset" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_control"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:thumbTint="@color/accent"
                        android:progressTint="@color/accent"
                        android:progressBackgroundTint="@color/seekbar_background" />

                    <Spinner
                        android:id="@+id/spinner_control_mode"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
